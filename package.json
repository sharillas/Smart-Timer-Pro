{
  "name": "smart-timer-pro",
  "version": "3.0.1",
  "description": "Smart Timer Pro - Professional Stage Timer for smartchoice",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/server.test.js tests/frontend.test.js",
    "bump": "node scripts/bump-version.js",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "build": "node scripts/bump-version.js && node scripts/build-installer.js",
    "icon": "npx electron scripts/make-icon.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "node-forge": "^1.4.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "author": "smartchoice",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.smartchoice.smarttimerpro",
    "productName": "Smart Timer Pro",
    "afterPack": "scripts/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "sharillas",
        "repo": "Smart-Timer-Pro"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "messages.json",
        "to": "messages.json"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "SmartTimerPro",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Timer Pro"
    }
  }
}
